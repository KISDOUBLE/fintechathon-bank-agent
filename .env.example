# 复制为 .env 后填写。.env 已被 .gitignore 忽略，禁止提交。
# 只从环境变量读取，源码中不得出现任何密钥。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek-V4.1-Flash-1017 的调用名是 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash

# 外部服务调用超时（毫秒），超时按失败处理，不阻塞主流程
EXTERNAL_TIMEOUT_MS=2500

# 渠道端口
WEBHOOK_PORT=8788

# 身份令牌签名密钥。不填则每次启动随机生成（重启后旧令牌失效）
SESSION_SECRET=
# 令牌有效期（毫秒），默认 30 分钟
SESSION_TTL_MS=1800000
# 渠道共享密钥。配置后 webhook 必须带 x-webhook-secret
WEBHOOK_SECRET=

# 账本路径
DB_PATH=data/bank.db
